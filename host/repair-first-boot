#!/bin/sh
set -eu

instance_id_file="${PLATFORM_CLOUD_INSTANCE_ID_FILE:-/var/lib/cloud/data/instance-id}"
state_dir="${PLATFORM_REPAIR_STATE_DIR:-/var/lib/platform-repair}"
limit=3

cloud-init status --wait > /dev/null 2>&1 || true

if [ "$(cat "$instance_id_file" 2> /dev/null || true)" != "iid-datasource-none" ]; then
  echo "The first boot found its setup, so there is nothing to repair"
  exit 0
fi

mkdir -p "$state_dir"
restarts="$(cat "$state_dir/restarts" 2> /dev/null || echo 0)"
if [ "$restarts" -ge "$limit" ]; then
  echo "The first boot still misses its setup after $restarts restarts, so a person has to look" >&2
  exit 1
fi

restarts=$((restarts + 1))
echo "$restarts" > "$state_dir/restarts"
echo "The first boot missed its setup, so cloud-init starts again after restart $restarts of $limit"
cloud-init clean --logs
shutdown -r +1 "cloud-init starts the first boot again"
