[Unit]
Description=Removes stopped containers, unused networks and unused images older than 7 days
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker container prune --force --filter until=168h
ExecStart=/usr/bin/docker network prune --force --filter until=168h
ExecStart=/usr/bin/docker image prune --all --force --filter until=168h
