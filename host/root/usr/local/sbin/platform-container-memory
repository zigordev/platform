#!/usr/bin/env bash
set -euo pipefail

metrics_dir="${PLATFORM_METRICS_DIR:-/var/lib/platform/metrics}"
cgroup_root="${PLATFORM_CGROUP_ROOT:-/sys/fs/cgroup}"
target="$metrics_dir/containers.prom"

mkdir -p "$metrics_dir"
draft="$(mktemp "$metrics_dir/.containers.XXXXXX")"
trap 'rm -f "$draft"' EXIT

docker ps --no-trunc --format '{{.ID}}|{{.Names}}|{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.compose.service"}}' |
  while IFS='|' read -r id name project service; do
    scope="$cgroup_root/system.slice/docker-$id.scope"
    current="$(cat "$scope/memory.current" 2> /dev/null)" || continue
    limit="$(cat "$scope/memory.max" 2> /dev/null)" || continue
    inactive="$(awk '$1 == "inactive_file" { print $2 }' "$scope/memory.stat" 2> /dev/null)" || continue
    used=$((current - ${inactive:-0}))
    if [ "$used" -lt 0 ]; then
      used=0
    fi
    labels="container=\"$name\",service_name=\"$service\",compose_project=\"$project\""
    printf 'container_memory_working_set_bytes{%s} %s\n' "$labels" "$used"
    if [ "$limit" != "max" ]; then
      printf 'container_spec_memory_limit_bytes{%s} %s\n' "$labels" "$limit"
    fi
  done > "$draft"

chmod 0644 "$draft"
mv "$draft" "$target"
trap - EXIT
