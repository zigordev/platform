{
  "name": "platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prepare": "lefthook install",
    "format": "biome check --write . && markdownlint-cli2 --fix",
    "format:check": "biome format .",
    "lint": "biome ci . && markdownlint-cli2 && zizmor --offline . && zigordev check",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present run typecheck",
    "local:up": "pnpm run build && zigordev-stack up",
    "local:down": "zigordev-stack down",
    "local:reset": "pnpm run build && zigordev-stack reset",
    "build": "pnpm -r --if-present run build",
    "test": "vitest run --coverage",
    "check:quick": "pnpm run lint && pnpm run build && pnpm run typecheck && vitest run",
    "check": "start=$(date +%s); pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run test; code=$?; echo \"check took $(( $(date +%s) - start )) s\"; exit $code"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zigordev/dev": "catalog:",
    "@zigordev/stack": "workspace:*",
    "lefthook": "catalog:",
    "markdownlint-cli2": "catalog:",
    "semantic-release": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
